# Bloqueio geral para o diretório database, com exceção controlada para o runner.php
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Deny from all
</IfModule>

# Permite acesso HTTP ao runner.php e reset_dados_teste.php para hospedagem compartilhada (Hostnet), protegidos por token interno
<FilesMatch "^(runner|reset_dados_teste)\.php$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Allow from all
    </IfModule>
</FilesMatch>

